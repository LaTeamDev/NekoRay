<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net9.0;net9.0-windows</TargetFrameworks>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
        <NekoRayProjectId>web</NekoRayProjectId>
        <CopyAllData>true</CopyAllData>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <Import Project="../NekoRay/game.targets" />

    <ItemGroup>
      <ProjectReference Include="..\..\YogaSharp\Yoga\Yoga.csproj" />
      <ProjectReference Include="..\NekoRay\NekoRay.csproj" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="AngleSharp" Version="1.2.0-beta.439" />
      <PackageReference Include="AngleSharp.Css" Version="1.0.0-beta.144" />
      <PackageReference Include="FreeTypeSharp" Version="3.0.0" />
      <PackageReference Include="HarfBuzzSharp" Version="8.3.1-preview.1.2" />
      <PackageReference Include="MimeTypeMapOfficial" Version="1.0.17" />
      <PackageReference Include="OpenTK" Version="5.0.0-pre.13" />
      <PackageReference Include="SkiaSharp" Version="3.118.0-preview.1.2" />
    </ItemGroup>

    <ItemGroup>
      <None Update="web\conf.toml">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
      <None Update="web\cfg\autoexec.cfg">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
      <None Update="web\cfg\video.default.toml">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
    </ItemGroup>

    <ItemGroup>
      <Folder Include="web\font\" />
    </ItemGroup>

</Project>
